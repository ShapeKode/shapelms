{
  "name": "shapelms",
  "version": "1.0.0",
  "description": "ShapeLMS - a fast, modern learning management system for WordPress.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=assets/build && rtlcss assets/css/frontend.css assets/css/frontend-rtl.css",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=assets/build",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style src",
    "format": "wp-scripts format src",
    "makepot": "wp i18n make-pot . languages/shapelms.pot --exclude=node_modules,vendor,tests,src"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "@wordpress/notices": "^5.0.0",
    "@wordpress/url": "^4.0.0"
  }
}
